# Copia este archivo como .env dentro de backend y ajusta tus credenciales.
# PostgreSQL debe estar en ejecucion y la base sypho_library debe existir.
# Cambia tambien el puerto si tu PostgreSQL no utiliza 5432.
# Si tu clave contiene caracteres especiales, codificalos para una URL.
DATABASE_URL="postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/sypho_library?schema=public"

# Puerto del servidor Express.
PORT=5010
